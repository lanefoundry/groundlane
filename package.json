{
  "name": "groundlane",
  "version": "0.1.0",
  "private": true,
  "description": "The trusted web access layer for AI agents.",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "pnpm run build:container && pnpm run typecheck",
    "build:container": "tsup --config tsup.config.ts && node scripts/check-container-bundle.mjs",
    "benchmark:parser": "tsx scripts/benchmark-parser.mts",
    "benchmark:reader": "tsx scripts/benchmark-reader.mts",
    "dev": "tsx watch src/container/server.ts",
    "dev:worker": "wrangler dev",
    "lint": "eslint .",
    "secrets:setup": "tsx scripts/cloudflare-secrets.mts setup",
    "secrets:status": "tsx scripts/cloudflare-secrets.mts status",
    "smoke": "node scripts/smoke.mjs",
    "smoke:retry": "node scripts/smoke-retry.mjs",
    "test": "node --test --import tsx --import ./test/support/node-test-setup.mjs 'test/**/*.test.ts'",
    "test:coverage": "c8 pnpm test",
    "typecheck": "tsc --noEmit",
    "cf-typegen": "wrangler types",
    "wait:container": "node scripts/wait-cloudflare-container.mjs",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@cloudflare/containers": "^0.3.7",
    "@cloudflare/workers-oauth-provider": "^0.10.3",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@mozilla/readability": "^0.6.0",
    "cheerio": "^1.1.2",
    "express": "^5.1.0",
    "fflate": "^0.8.3",
    "linkedom": "^0.18.13",
    "pdfjs-dist": "^6.3.289",
    "playwright": "^1.55.0",
    "playwright-extra": "^4.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "saxes": "^6.0.0",
    "turndown": "^7.2.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "@types/turndown": "^5.0.5",
    "c8": "^10.1.3",
    "eslint": "^9.34.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.41.0",
    "wrangler": "^4.32.0"
  },
  "packageManager": "pnpm@10.15.1"
}
