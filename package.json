{
  "name": "groundlane",
  "version": "0.1.0",
  "private": true,
  "description": "The trusted web access layer for AI agents.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm run build:container && pnpm run typecheck",
    "build:container": "tsup src/container/server.ts --format esm --platform node --target node22 --out-dir dist/container --clean",
    "dev": "tsx watch src/container/server.ts",
    "dev:worker": "wrangler dev",
    "lint": "eslint .",
    "smoke": "node scripts/smoke.mjs",
    "test": "node --test --import tsx 'test/**/*.test.ts'",
    "test:coverage": "c8 pnpm test",
    "typecheck": "tsc --noEmit",
    "cf-typegen": "wrangler types",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@cloudflare/containers": "^0.3.7",
    "@modelcontextprotocol/sdk": "1.29.0",
    "cheerio": "^1.1.2",
    "express": "^5.1.0",
    "playwright": "^1.55.0",
    "playwright-extra": "^4.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "turndown": "^7.2.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "@types/turndown": "^5.0.5",
    "c8": "^10.1.3",
    "eslint": "^9.34.0",
    "tsx": "^4.20.5",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.41.0",
    "wrangler": "^4.32.0"
  },
  "packageManager": "pnpm@10.15.1"
}
