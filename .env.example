PORT=8080
GROUNDLANE_AUTH_TOKEN=replace-with-a-long-random-secret
GROUNDLANE_MCP_PROTOCOL_MODE=legacy-only
GROUNDLANE_MCP_REQUEST_STATE_SECRET=
SEARCH_PROVIDER_ORDER=tavily,exa,brave,you,tinyfish,keenable,browserbase,firecrawl,linkup,parallel,serpapi
SEARCH_MONTHLY_REQUEST_BUDGETS=tavily:800,exa:1200,brave:1000,you:3000,tinyfish:3000,keenable:100,browserbase:1000,firecrawl:500,linkup:100,parallel:500,serpapi:250,searchapi:0,serper:0
SEARCH_DAILY_REQUEST_BUDGETS=you:100
TAVILY_API_KEY=
EXA_API_KEY=
BRAVE_API_KEY=
FIRECRAWL_API_KEY=
SERPAPI_API_KEY=
SEARCHAPI_API_KEY=
BROWSERBASE_API_KEY=
PARALLEL_API_KEY=
LINKUP_API_KEY=
KEENABLE_API_KEY=
TINYFISH_API_KEY=
SERPER_API_KEY=
YOU_API_KEY=
# Self-hosted SearXNG meta-search instance (no API key, zero cost)
SEARXNG_BASE_URL=
# Self-hosted Crawl4AI Docker instance for web content extraction (no API key, zero cost)
CRAWL4AI_BASE_URL=
READER_BACKEND=disabled
BROWSER_BACKEND=local
BROWSERLESS_TOKEN=
BROWSERLESS_REGION=sfo
# Hyperbrowser browser-as-a-service (free: 1,000 credits at https://hyperbrowser.ai)
HYPERBROWSER_API_KEY=
JINA_READER_RPM=20
BROWSERLESS_MONTHLY_UNITS=1000
REQUEST_TIMEOUT_MS=30000
MAX_RESPONSE_BYTES=2000000
MAX_OUTPUT_CHARS=100000
MAX_CONCURRENCY=4
MAX_QUEUE=16
DOCUMENT_CACHE_STATE_PATH=
# Self-hosted durable oversized document results; independent of processing cache.
DOCUMENT_ARTIFACT_STATE_PATH=
# Container-to-Worker D1/R2 output bridge; enable only with the corresponding Worker flag.
DOCUMENT_OUTPUT_EDGE_ENABLED=false
# Self-hosted durable corpus manifest, immutable source bytes, and rebuildable index.
CORPUS_STATE_PATH=
CORPUS_TENANT_ID=default
CORPUS_MAX_SOURCE_BYTES=1000000
# Cloudflare Container only; the Worker derives this from explicit edge policy and bindings.
DOCUMENT_CACHE_EDGE_ENABLED=false
ASYNC_TASK_STATE_PATH=
# Cloudflare Worker only: direct-to-R2 presigned upload handoff.
R2_ACCOUNT_ID=
R2_BUCKET_NAME=groundlane-artifacts
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
DOCUMENT_UPLOAD_MAX_TTL_SECONDS=3600
DOCUMENT_ARTIFACT_MAX_TTL_SECONDS=2592000
DOCUMENT_CACHE_DEFAULT_TTL_SECONDS=86400
DOCUMENT_CACHE_MAX_TTL_SECONDS=2592000
# OCR for scanned PDFs and images (free: 25,000 req/month at https://ocr.space)
OCR_SPACE_API_KEY=
# Legacy Office conversion .doc/.xls/.ppt → .docx/.xlsx/.pptx (free: 25/day at https://cloudconvert.com)
CLOUDCONVERT_API_KEY=
