{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "groundlane",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-08-20",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "SEARCH_PROVIDER_ORDER": "tavily,exa,parallel,browserbase,brave,firecrawl,serpapi",
    "SEARCH_MONTHLY_REQUEST_BUDGETS": "tavily:1000,exa:1000,parallel:5000,browserbase:1000,brave:1000,firecrawl:500,serpapi:250",
    "READER_BACKEND": "disabled",
    "BROWSER_BACKEND": "local",
    "BROWSERLESS_REGION": "sfo",
    "REQUEST_TIMEOUT_MS": "30000",
    "MAX_RESPONSE_BYTES": "2000000",
    "MAX_OUTPUT_CHARS": "100000",
    "MAX_CONCURRENCY": "4",
    "MAX_QUEUE": "16"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "GROUNDLANE_CONTAINER",
        "class_name": "GroundlaneContainer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["GroundlaneContainer"]
    }
  ],
  "containers": [
    {
      "class_name": "GroundlaneContainer",
      "image": "./Dockerfile",
      "max_instances": 5
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
