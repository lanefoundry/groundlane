{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "groundlane",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-08-20",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      "id": "5af8b9bb5bcd4964abe95c0f25473c4b"
    }
  ],
  "vars": {
    "SEARCH_PROVIDER_ORDER": "tavily,exa,brave,you,keenable,browserbase,firecrawl,linkup,parallel,serpapi",
    "SEARCH_MONTHLY_REQUEST_BUDGETS": "tavily:800,exa:1200,brave:1000,you:3000,keenable:100,browserbase:1000,firecrawl:500,linkup:100,parallel:500,serpapi:250,serper:0",
    "SEARCH_DAILY_REQUEST_BUDGETS": "you:100",
    "READER_BACKEND": "disabled",
    "BROWSER_BACKEND": "local",
    "BROWSERLESS_REGION": "sfo",
    "REQUEST_TIMEOUT_MS": "30000",
    "MAX_RESPONSE_BYTES": "2000000",
    "MAX_OUTPUT_CHARS": "100000",
    "MAX_CONCURRENCY": "4",
    "MAX_QUEUE": "16"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "GROUNDLANE_CONTAINER",
        "class_name": "GroundlaneContainer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "GroundlaneContainer"
      ]
    }
  ],
  "containers": [
    {
      "class_name": "GroundlaneContainer",
      "image": "./Dockerfile",
      "instance_type": "basic",
      "max_instances": 1
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
